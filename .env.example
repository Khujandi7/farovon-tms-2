# FAROVON TMS 2.0 — переменные окружения. Скопируйте в .env.local и заполните. .env.local в Git не попадает.
# Значения: Supabase → Project Settings → API (или Connect). НЕ вставляйте сюда реальные ключи.

# Публичные (попадают в браузер; защищены RLS). URL проекта и publishable (anon) ключ.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Адрес приложения (для ссылок в письмах Auth). Локально: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секретные (ТОЛЬКО сервер; никогда не с префиксом NEXT_PUBLIC_). В Phase 2.1 не используется.
# Понадобится для приглашения пользователей администратором (Phase 2.2).
# SUPABASE_SERVICE_ROLE_KEY=
