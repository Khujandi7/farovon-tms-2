# FAROVON TMS 2.0 — переменные окружения. Скопируйте в .env.local и заполните. .env.local в Git не попадает.
# Значения: Supabase → Project Settings → API (или Connect). НЕ вставляйте сюда реальные ключи.

# Публичные (попадают в браузер; защищены RLS). URL проекта и publishable (anon) ключ.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Адрес приложения (для ссылок в письмах Auth). Локально: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секретный ключ (ТОЛЬКО сервер; никогда не с префиксом NEXT_PUBLIC_). Нужен разделу Settings → Users (Phase 2.2):
# приглашение, блокировка, чтение email и даты входа через Auth Admin API. Без него раздел покажет «не настроено».
# В Vercel: Environment Variables → без NEXT_PUBLIC_, для Production и Preview.
# SUPABASE_SERVICE_ROLE_KEY=

# Публичный портал заявок /request (Phase 3A.1). Необязательно; только сервер.
# Секрет HMAC для client_hash (IP+User-Agent). Если не задан, берётся производный от SUPABASE_SERVICE_ROLE_KEY. Минимум 16 символов.
# PUBLIC_REQUEST_HASH_SECRET=
# Провайдер CAPTCHA: none (по умолчанию, проверка отключена). Внешние сервисы пока не подключены.
# PUBLIC_REQUEST_CAPTCHA=none
